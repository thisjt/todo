{
	"name": "todo",
	"version": "0.0.1",
	"type": "module",
	"properName": "Todo Application",
	"author": "thisjt",
	"authorUrl": "https://thisjt.me",
	"authorEmail": "contact@thisjt.me",
	"description": "A Hono Backend API server for a simple todo application, implementing Clean Architecture and integrating OpenAPI that can be consumed by any service that conforms to OpenAPI standards.",
	"private": false,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler pages dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"deploy": "pnpm run build && wrangler pages deploy",
		"cf-typegen": "wrangler types && move worker-configuration.d.ts src/",
		"cf-d1:generate": "prisma generate",
		"cf-d1:create-migrate": "prisma migrate diff --from-local-d1 --to-schema-datamodel ./prisma/schema.prisma --script --output migrations/####_###_what_changed_###.sql",
		"cf-d1:remote": "wrangler d1 migrations apply todo --remote",
		"cf-d1:local": "wrangler d1 migrations apply todo --local"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241106.0",
		"@evyweb/ioctopus": "^1.0.0",
		"@hono/zod-openapi": "^0.18.0",
		"@playwright/test": "^1.45.3",
		"@prisma/adapter-d1": "^5.22.0",
		"@prisma/client": "^5.22.0",
		"@scalar/hono-api-reference": "^0.5.161",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-cloudflare": "^4.7.4",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/eslint": "^9.6.0",
		"@vitest/coverage-istanbul": "^2.1.8",
		"autoprefixer": "^10.4.20",
		"daisyui": "^4.12.14",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"hono": "^4.6.12",
		"hono-pino": "^0.7.0",
		"pino": "^9.5.0",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"prisma": "^5.22.0",
		"stoker": "^1.4.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.9",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.0.3",
		"vitest": "^2.1.8",
		"wrangler": "^3.86.1"
	}
}
